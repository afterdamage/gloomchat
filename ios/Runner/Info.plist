		<string>Record voice messages and share them with your contacts.</string>
		<key>NSMotionUsageDescription</key>
		<string>Share motion data with your contacts.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Share photos with your contacts.</string>
